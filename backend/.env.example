# Mood Machine Backend Environment Configuration Template

# Server Port (Render will override with its own $PORT)
PORT=8000

# CORS Allowed Origins (comma-separated list of allowed frontend URLs)
# For local dev: http://localhost:5173
# For production: https://your-frontend.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,https://mood-machine.vercel.app

# Model Path (relative or absolute path to the .keras model file)
MODEL_PATH=../imageclassifier.keras

# Optional: External URL to download the model from if not present in the repository
# (e.g. GitHub Releases URL, Hugging Face direct link, or S3/GCS presigned URL)
MODEL_URL=

# Model Classification Labels and Threshold
# Note: Keras binary classification with sigmoid output evaluates to a probability [0.0, 1.0].
# By default, lower probabilities (< 0.5) map to LABEL_ZERO and higher (>= 0.5) map to LABEL_ONE.
LABEL_ZERO=Happy
LABEL_ONE=Sad
THRESHOLD=0.5

# Pixel Normalization (255.0 divides [0, 255] RGB values to [0.0, 1.0])
NORMALIZE_DIVISOR=255.0

# Maximum allowed upload file size in Megabytes
MAX_IMAGE_SIZE_MB=10
